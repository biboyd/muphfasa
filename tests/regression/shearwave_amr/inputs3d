# 3-D variant of ./inputs (D3Q19, prob_hi z = 0.5, Ny = 32).
# Same shear wave u_x(y,t), u_y=V, u_z=0, nu=0.1, k=2pi/32 => nu k^2 t=0.5 at t=130.
# Tag boxes finite in all dims including z.

grid.ncells        = 32 32 16
grid.max_grid_size = 16
grid.n_ghost       = 1

amr.max_level       = 2
amr.blocking_factor = 8
amr.n_error_buf     = 0
tagging.box_lo_0    = 0.25 0.25 0.125
tagging.box_hi_0    = 0.75 0.625 0.375
tagging.box_lo_1    = 0.375 0.375 0.1875
tagging.box_hi_1    = 0.625 0.5 0.3125

sim.max_step     = 130
sim.stop_time    = -1.0

lbm.lattice_type = D3Q19
lbm.tau          = 0.8
units.ref_length    = 32.0
units.ref_velocity  = 0.002
units.Re            = 1.0

shearwave.bg_frac = 2.0

bc.lo_type = Periodic  Periodic  Periodic
bc.hi_type = Periodic  Periodic  Periodic

geometry.prob_lo = 0.0  0.0  0.0
geometry.prob_hi = 1.0  1.0  0.5

amr.plot_int   = 43
amr.chk_int    = -1
amr.plot_file  = plt
amr.check_file = chk

# N=32 tau=0.8 nu k^2 t=0.5, bg_frac=2: observed inf 4.96e-3 L2 3.22e-3 mass 1.1e-14 mom 4.5e-14
# (amr.reflux = 0: same errors, mass 1.94e-8 mom 6.60e-6)
# single level: inf 6.96e-3 L2 4.94e-3 mass 2.2e-16 mom 1.15e-13
shearwave.min_finest     = 2
shearwave.max_err        = 1.0e-2
shearwave.max_l2_err     = 6.0e-3
shearwave.max_mass_drift = 1.e-10
shearwave.max_mom_defect = 1.e-10
